# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# Gmail: enable 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste the 16 characters here.
# An app password only grants mail access and can be revoked at any time.
IMAP_USER=you@gmail.com
IMAP_PASSWORD=xxxxxxxxxxxxxxxx
IMAP_HOST=imap.gmail.com
